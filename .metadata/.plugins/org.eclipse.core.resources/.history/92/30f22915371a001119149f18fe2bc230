package Arrays;

public class x08_MaxConsecutiveOnes {

	public static void main(String[] args) {
		
		int[] arr = {1,1,0,1,1,1,1,1,0,0,0};
		
		boolean flag = false;
		int count = 0;
		int max=0;
		for(int i=0;i<arr.length;i++) {
			
			if(arr[i]==1) {
				flag=true;
				if(flag) {
				count++;
			  max=Math.max(count,max);
				}
			}
			  
		  if(arr[i]==0) {
			  flag=false;
			  count=0;
		  }
	
	}
		 System.out.println(max);
	}
}
