package Arrays;

import java.util.Arrays;
import java.util.HashMap;
import java.util.List;

public class x17_MajorityElement {
     public static void main(String[] args) {
		
    	 int[] arr = {2,2,1,1,1,2,2};
    	 
    	 
    	  // Better Approach 
    	 List<Integer> ls =  Arrays.asList(2,2,1,1,1,2,2);
    	 
    	 int n = arr.length;
    	 HashMap<Integer,Integer> hp = new HashMap<>();
    	 
    	 for(int i=0;i<n;i++) {
    		 hp.put(arr[i],hp.getOrDefault(arr[i],0)+1);
    	 }
    	 int maxFreq =0;
    	 int number =-1;
    	 for(Integer key : hp.keySet()) {
    		  
    		  int freq = hp.get(key);
    		  if(freq>maxFreq ) {
    			  maxFreq=freq;
    			  number=key;
    		  }
    		 
    	 }
    	 System.out.println(number);
         // OPtimal Approah  // Morre's Voting Algorithm
    	 
    	 int cnt=0;
    	 int ele=0;
    	 
    	 for(int i=0;i<n;i++)
    	 {
    		 if(cnt ==0)
    		 { 
    			cnt=1;
    			ele=arr[i];
    		 }
    		 if(ele==arr[i]) {
    			 cnt++;
    		 }
    		 else {
    			 cnt--;
    		 }
    	 }
    	 int cnt1=0;
    	 for(int i=0;i<n;i++) {
    		 
    		 if(arr[i]==ele)cnt1++;
    		 
    		 if(cnt1>n/2) {
    			 System.out.println(ele);
    		 }
    		 
    	 }
    	 
    	 
    	 
     }
