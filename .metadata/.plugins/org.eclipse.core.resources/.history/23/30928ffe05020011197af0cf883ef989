package x11_Striver_Arrays;

public class x04_RemoveDuplicateElement {

	public static void main(String[] args) {
		       // we have to remove duplicate from sorted array without taking extra array
		  
		int[] arr = {1,1,2,2,2,3,3};
		
	   // OP :-  {1,2,3,_,_,_,_};
		
		int index =0 ;
		int first = arr[0];
		
		for(int i=1;i<arr.length;i++) {
			if(first<arr[i]) {
				index++;
				arr[index]=arr[i];
				first=arr[i];
			}
		}
		for(int i =0;i<=index;i++) {
			 System.out.println(arr[i]);
		}
		
		
		
	}
}
