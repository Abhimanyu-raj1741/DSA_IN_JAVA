package com.practice;

public class x02_MiddleOfLinkedList {
	
      static class Node {
		  int data ;
		  Node next;
		  
		  Node(int data){
			  this.data = data;
			  this.next =null;
		  }
		  
		 
	}
      Node head;
      
      public void middleOfLink() {
    	     Node temp = head;
    	     
    	     Node slow =null;
    	     Node fast =null ;
    	     
    	     while(temp.next.next!=null) {
    	    	     slow =temp.next;
    	    	     fast =temp.next.next;
    	     }
    	     System.out.println(slow.data);
      }
 
	public static void main(String[] args) {
		 Node head = new Node(10);
		 Node second = new Node(20);
		 Node third = new Node(30);
		 Node fourth = new Node(40);
		 Node fifth = new Node(50);
		 Node sixth = new Node(60);
		 
		 head.next =second;
		 second.next=third;
		 third.next=fourth;
		 fourth.next=fifth;
		 fifth.next=sixth;
		 
		 middleOfLink();
	}

}
