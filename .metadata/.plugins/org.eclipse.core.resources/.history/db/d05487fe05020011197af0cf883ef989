	  // Optimal 
	  int[] arr1 = {1, 2, 3, 4, 5};
	  int[] arr2 ={1, 2, 7};
	  
	  List<Integer> a1 = new ArrayList<>();
	  
	  int i =0;
	  int j =0;
	  int n = arr1.length;
	  int m = arr2.length;
	  
	  while(i<n && j<m) {
		  // 1st Condition 
		    if(arr1[i]==arr2[j]) {
		    	  if(a1.isEmpty() || a1.get(a1.size()-1)!=arr1[i])
		    		  a1.add(arr1[i]);
		    	  i++;
		    	  j++;
		    
		    }
		    //  2nd condition
		    else if(arr1[i]<arr2[j]) {
