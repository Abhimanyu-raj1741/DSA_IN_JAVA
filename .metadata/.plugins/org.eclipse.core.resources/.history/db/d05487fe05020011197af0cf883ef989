		    		 a1.add(arr1[i]);
		    	    i++;
		    }
		    // 3rd condition
		    else {
		    	   if(a1.isEmpty()||a1.get(a1.size()-1)!=arr2[j])
		    		   a1.add(arr2[j]);
		    	   j++;
		    }
	  }
	  while(i<n) {
		  if(a1.isEmpty() || a1.get(a1.size()-1)!=arr1[i])
			  a1.add(arr1[i]);
		  i++;
	  }
	  while(j<m) {
		  if(a1.isEmpty() || a1.get(a1.size()-1)!=arr2[j])
			  a1.add(arr2[j]);
		  j++;
	  }
	  
	  System.out.println(a1);
	   
