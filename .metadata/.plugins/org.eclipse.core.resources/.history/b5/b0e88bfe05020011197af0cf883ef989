package x11_Striver_Arrays;

import java.util.Arrays;
import java.util.List;

public class x11_SingleNumber {

	public static void main(String[] args) {
//		Input : nums= [1, 2, 2, 4, 3, 1, 4]
//
//				Output : 3 
		
		List<Integer> ls = Arrays.asList(1, 2, 2, 4, 3, 1, 4,3,5);
		
		int result=0;
		
		for(Integer i : ls)  result =i^result;
		
		System.out.println(result);
		
		
	}
	
	
}
