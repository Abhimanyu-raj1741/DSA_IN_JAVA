package com.practice;

import java.util.Stack;

public class PracticeBeast { 

		public static boolean isomorphic(String str,String str1) {
	       int[] arr = new int[255];
	       int[] arr1 = new int [255];
	       
	       int s1  = str.length();
	       if(s1!=str1.length()) return false ;
	       
	       
	       for(int i=0;i<s1;i++) {
	    	       if(arr[str.charAt(i)]!=arr1[str1.charAt(i)]) return false ;
	    	       
	    	       arr[str.charAt(i)]=i+1;
	    	       arr1[str1.charAt(i)]=i+1;
	    	       
	    	       
	       }
	       return true;
			
	   }
          
	public static void main(String[] args) {
		
		    String str = "add";
		    String str1 = "title" ;
		    System.out.println(isomorphic(str,str1));
	}
		 

}
