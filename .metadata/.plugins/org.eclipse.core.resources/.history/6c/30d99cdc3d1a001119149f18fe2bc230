package Arrays;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.HashSet;
import java.util.List;

public class x13_ThreeSum {
      public static void main(String[] args) {
		
    	  int[] arr = {-1,0,1,2,-1,-4};
    	  int target = 0;
    	  int n =arr.length;
    	  List<List<Integer>> listofls= new ArrayList<>();
    	  HashSet<List<Integer>> hs = new HashSet<>();
    	  for(int i =0;i<n;i++) {
    		  for(int j=i+1;j<n;j++) {
    			  for (int k=j+1;k<n;k++) {
    				   if(arr[i]+arr[j]+arr[k]==0) {
    					   List<Integer> ls = Arrays.asList(i,j,k);
    					   Collections.sort(ls);
    					   listofls.add(ls);
    					   
    				   }
    			  }
    		  }
    	  }
    	  for(List<Integer> ls :listofls) {
    		        System.out.println(ls);
    	  }
    	  
    	 
	}
}
